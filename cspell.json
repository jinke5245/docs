{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-software-terms/cspell-ext.json"],
  "allowCompoundWords": true,
  "ignorePaths": ["*-lock.{json,yaml}"],
  "ignoreRegExpList": ["Email", "Urls", "Base64", "string"],
  "ignoreWords": ["commitlintrc"],
  "useGitignore": true,
  "words": ["jinke", "MOCs"]
}
