{
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@cspell/dict-software-terms": "^5.2.2",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "cspell": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json-schema-validator": "^6.2.0",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-yml": "^3.5.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-toml": "^2.0.6",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint": "^10.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "secretlint": "^13.0.2"
  },
  "scripts": {
    "prepare": "node scripts/prepare-husky.mjs",
    "check": "run-s lint format:check",
    "lint-staged": "lint-staged --concurrent false",
    "lint": "run-s --continue-on-error lint:*",
    "lint:eslint": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown-remark": "remark . --quiet --frail",
    "lint:secret": "secretlint",
    "lint:spelling": "cspell .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,json5,yml,yaml,toml}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{md,mdx}": [
      "eslint --fix",
      "markdownlint-cli2",
      "prettier --write"
    ],
    ".*rc": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.sh": "prettier --write",
    "**/*": "secretlint"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
